# Peer dependencies are provided by the DSH installation's shared closure at
# runtime ($DSH_HOME/profiles/node_modules), so a published or git-installed
# copy needs nothing here.
#
# A *symlinked* development checkout is different: Node resolves the symlink to
# its real path, so the walk never reaches the shared closure. DSH profiles set
# `autoInstallPeers: false`, which would leave the peers unresolved. Forcing it
# on makes a plain `pnpm install` in this directory materialize them locally so
# the checkout loads while it is symlinked into a profile.
auto-install-peers=true
